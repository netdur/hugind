dynamic main(Map<String, dynamic> context) async {
  SysCapability sys = context['capabilities']['sys'];
  LlmCapability llm = context['capabilities']['llm'];

  sys.print('CLI Navigator ready. Describe what you want, or type "exit" to quit.');

  while (true) {
    var input = sys.readInput('> ');
    
    if (input == null) break;
    // Treating input as dynamic/String
    var sInput = input.toString().trim();

    if (sInput == 'exit' || sInput == 'quit') {
      sys.print('Goodbye.');
      break;
    } else if (sInput.isEmpty) {
       // reprompt by doing nothing and looping
    } else {
      sys.print('Thought: Turn the request into a safe single command.');

      // Simplified prompt
    var prompt = 'You translate plain English tasks into a single safe shell command to run on the current machine.\n' +
                 '- Output format: \n' +
                 '  * "SAFE_COMMAND: <command>" for read-only operations (ls, cat, grep, echo, find, etc.)\n' +
                 '  * "DANGEROUS_COMMAND: <command>" for state-changing operations (touch, rm, mv, mkdir, chmod, installing, etc.)\n' +
                 '  * "NO_COMMAND: <short reason>" if you cannot fulfill the request.\n' +
                 '- Use POSIX tools by default; only use Windows-specific tools if explicitly needed.\n' +
                 '- No extra text besides the format above.\n\n' +
                 'User request: $sInput';

      var plan = await llm.chat(prompt);
      // sys.print('DEBUG: Plan: $plan');
      var parsed = _parse(plan);

      if (parsed == null) {
        sys.print('Observation: could not understand model response:\n$plan');
      } else if (parsed['reason'] != null) {
        sys.print('Observation: ${parsed['reason']}');
      } else {
        var command = parsed['command']!;
        var isSafe = parsed['isSafe'] == 'true'; // dynamic string comparison safe in eval
        
        sys.print('Action: $command');
        
        var approved = true;
        if (!isSafe) {
           approved = await sys.confirm('⚠️  Dangerous command "$command". Execute?');
        } else {
           // sys.print('Auto-approving safe command.');
        }

        if (approved) {
           try {
             var output =
                 await sys.run('sh', ['-c', command]);
             if (output.trim().isEmpty) {
               sys.print('Observation: command produced no output.');
             } else {
               sys.print('Observation:\n$output');
             }
           } catch (e) {
             sys.print('Observation: command failed ($e)');
           }
        } else {
           sys.print('Observation: User rejected the command.');
        }
      }
    }
  }
}

Map<String, String?>? _parse(String response) {
  for (var line in response.split('\n')) {
    var trimmed = line.trim();
    if (trimmed.toUpperCase().startsWith('SAFE_COMMAND:')) {
      var cmd = trimmed.substring(13).trim();
      if (cmd.isNotEmpty) return {'command': cmd, 'reason': null, 'isSafe': 'true'};
    }
    if (trimmed.toUpperCase().startsWith('DANGEROUS_COMMAND:')) {
      var cmd = trimmed.substring(18).trim();
      if (cmd.isNotEmpty) return {'command': cmd, 'reason': null, 'isSafe': 'false'};
    }
    // Fallback for old format or mistakes
    if (trimmed.toUpperCase().startsWith('COMMAND:')) {
      var cmd = trimmed.substring(8).trim();
      // Assume dangerous by default if unspecified
      if (cmd.isNotEmpty) return {'command': cmd, 'reason': null, 'isSafe': 'false'};
    }
    if (trimmed.toUpperCase().startsWith('NO_COMMAND:')) {
      var reason = trimmed.substring(11).trim();
      return {
        'command': null,
        'reason': reason.isEmpty ? 'No reason given.' : reason,
         'isSafe': 'true'
      };
    }
  }
  return null;
}
