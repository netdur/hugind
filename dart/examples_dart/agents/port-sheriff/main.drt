typedef PidParser = String? Function(String output);

dynamic main(Map<String, dynamic> context) async {
  var sys = context['capabilities']['sys'];
  List<String> args =
      ((context['args'] as List?) ?? []).map((e) => e.toString()).toList();

  var port = args.isNotEmpty ? args[0] : '8080';
  sys.print('🛡️ PortSheriff engaged. Target: port $port');

  String? pid;

  pid ??= await _probe(
      sys,
      'I need to find what is running on port $port. I will try lsof.',
      'Run lsof -nP -i :$port',
      ['lsof', '-nP', '-i', ':$port'],
      _extractPid);

  pid ??= await _probe(
      sys,
      'lsof is unavailable or gave nothing. I will try netstat with Windows-style flags.',
      'Run netstat -ano | findstr $port',
      ['cmd', '/c', 'netstat -ano | findstr $port'],
      _extractPid);

  pid ??= await _probe(
      sys,
      'Trying a POSIX netstat fallback.',
      'Run netstat -anp | grep $port',
      ['sh', '-c', 'netstat -anp | grep $port'],
      _extractPid);

  if (pid == null) {
    sys.print('❌ No PID found using the available commands.');
    return;
  }

  sys.print('Thought: Now that I have the PID, I will terminate it.');
  sys.print('Action: kill -9 $pid');
  var killed = await _killProcess(sys, pid);
  if (killed) {
    sys.print('✅ Observation: Process $pid terminated (or termination signal sent).');
  } else {
    sys.print('⚠️ Observation: Failed to terminate process $pid.');
  }
}

Future<String?> _probe(SysCapability sys, String thought, String action,
    List<String> command, PidParser parser) async {
  sys.print('Thought: $thought');
  sys.print('Action: $action');
  try {
    var output = await sys.run(command.first, command.sublist(1));
    if (output.trim().isEmpty) {
      sys.print('Observation: command returned no output.');
      return null;
    }
    sys.print('Observation:\n$output');
    var pid = parser(output);
    if (pid != null) {
      sys.print('✅ Parsed PID: $pid');
    } else {
      sys.print('Observation: Could not parse PID from output.');
    }
    return pid;
  } catch (e) {
    sys.print('Observation: command failed ($e)');
    return null;
  }
}

String? _extractPid(String output) {
  var lines =
      output.split('\n').map((line) => line.trim()).where((l) => l.isNotEmpty);
  for (var line in lines) {
    var parts = line.split(RegExp(r'\\s+')).toList();
    for (var part in parts.reversed) {
      var candidate = part.split('/').first;
      if (int.tryParse(candidate) != null) {
        return candidate;
      }
    }
  }
  return null;
}

Future<bool> _killProcess(SysCapability sys, String pid) async {
  try {
    await sys.run('kill', ['-9', pid]);
    return true;
  } catch (_) {
    // Try Windows taskkill as a fallback
    try {
      await sys.run('taskkill', ['/PID', pid, '/F']);
      return true;
    } catch (e) {
      sys.print('Observation: kill attempts failed ($e)');
      return false;
    }
  }
}
